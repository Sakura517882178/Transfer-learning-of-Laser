{
  "name": "predict-330-infer",
  "input": {
    "TRAIN_ROOT": "/mnt/f/green-laser/3core",
    "CKPT": "/mnt/f/green-laser/3core/runs/repeat/tr53_s08/transfer/save_finetune/checkpoint_best.pt"
  },
  "steps": [
    {
      "id": "inf_train",
      "tool": "unimol",
      "params": {
        "subcommand": "infer_local",
        "work_dir": "$input.TRAIN_ROOT/runs/predict330",
        "checkpoint": "$input.CKPT",
        "split": "train",
        "device": "cuda",
        "output": "$input.TRAIN_ROOT/report/predict330_train.csv"
      }
    },
    {
      "id": "inf_valid",
      "tool": "unimol",
      "params": {
        "subcommand": "infer_local",
        "work_dir": "$input.TRAIN_ROOT/runs/predict330",
        "checkpoint": "$input.CKPT",
        "split": "valid",
        "device": "cuda",
        "output": "$input.TRAIN_ROOT/report/predict330_valid.csv"
      }
    }
  ]
}